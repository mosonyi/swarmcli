{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "replicas": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "tag": { "type": "string" }
      },
      "required": ["repo", "tag"]
    }
  },
  "required": ["replicas", "image"]
}
